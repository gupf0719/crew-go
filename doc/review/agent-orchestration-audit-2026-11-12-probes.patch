+func TestZZAuditAutoCompactAskResume(t *testing.T) {
+	summary := &zzAskSummary{}
+	main := &compactLoopModel{}
+	ag := agent_v2.NewBasicAgent(agent_v2.WithName("audit-ask"), agent_v2.WithModel(main), agent_v2.WithAutoCompact(&agent_v2.AutoCompactConfig{Enabled: true, Model: summary, ModelContextWindow: 300, SummaryMaxTokens: 50, SummaryBufferTokens: 50, MinCompactableTokens: 1}))
+	sess := &agent_v2.RunSession{RunID: "zz-audit-ask"}
+	for i := 0; i < 5; i++ {
+		sess.AddEvent(agent_v2.NewOutputEvent("audit-ask", schema.UserMessage(strings.Repeat("old question ", 100))))
+		sess.AddEvent(agent_v2.NewOutputEvent("audit-ask", schema.AssistantMessage(strings.Repeat("old answer ", 100))))
+	}
+	ctx := compose_v2.WithCheckpointerCtx(context.Background(), compose_v2.NewInMemoryCheckpointer())
+	_, err := ag.Run(ctx, sess, schema.UserMessage("new question"))
+	ie, ok := compose_v2.IsInterrupt(err)
+	if !ok {
+		t.Fatalf("expected first interrupt, got %v", err)
+	}
+	id := ie.AllQueries()[0].InterruptID
+	for i := 0; i < 3; i++ {
+		_, err = ag.Resume(ctx, sess.RunID, agent_v2.WithResumeSession(sess), agent_v2.WithResumeUserInputs(map[string]*schema.Message{id: schema.UserMessage("yes")}))
+		next, is := compose_v2.IsInterrupt(err)
+		if is {
+			t.Logf("resume=%d id=%s same_question=%v summary_calls=%d answered=%d main_calls=%d", i+1, next.AllQueries()[0].InterruptID, next.AllQueries()[0].InterruptID == id, summary.calls, summary.answered, main.calls)
+		}
+	}
+	if err != nil || summary.answered != 1 || main.calls != 1 {
+		t.Fatalf("answered addressed question must resume: err=%v summary_calls=%d answered=%d main_calls=%d", err, summary.calls, summary.answered, main.calls)
+	}
+}
