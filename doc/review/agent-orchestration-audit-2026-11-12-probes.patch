+type zzSliceElementRewrite struct{ hook.NoOpHooks }
+
+func (zzSliceElementRewrite) OnModelStart(ctx context.Context, _ *hook.AgentInfo, in *schema.ModelInput) (context.Context, error) {
+	if len(in.Messages) > 0 {
+		i := len(in.Messages) - 1
+		cp := *in.Messages[i]
+		cp.Content += " TRANSIENT-HOOK"
+		in.Messages[i] = &cp
+	}
+	return ctx, nil
+}
+func TestZZAuditHookSliceReplacementLeaksIntoBoundary(t *testing.T) {
+	ctx := compose_v2.WithThreadIDCtx(context.Background(), "zz-audit-boundary")
+	key := agent_v2.HistoryKey{Owner: "t", ConvID: "zz-audit-boundary"}
+	hs := agent_v2.NewInMemoryHistoryStore()
+	summary := &countingSummarizer{}
+	ag := agent_v2.NewBasicAgent(agent_v2.WithName("coder"), agent_v2.WithModel(&compactLoopModel{rounds: 60}), agent_v2.WithToolkit(grepToolkit()), agent_v2.WithMaxRounds(100), agent_v2.WithHistory(hs, "t"), agent_v2.WithMaxHistoryPairs(0), agent_v2.WithHooks(zzSliceElementRewrite{}), agent_v2.WithAutoCompact(smallWindow(summary)))
+	if _, err := ag.Run(ctx, agent_v2.NewRunSession(), schema.UserMessage("original")); err != nil {
+		t.Fatal(err)
+	}
+	all, err := agent_v2.LoadAllHistory(ctx, hs, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaked := 0
+	for _, m := range all {
+		if raw, ok := m.Annotations[agent_v2.HistoryCompactionAnnotation].(string); ok && strings.Contains(raw, "TRANSIENT-HOOK") {
+			leaked++
+		}
+	}
+	t.Logf("summary_calls=%d boundaries=%d leaked=%d", summary.count(), countBoundaries(all), leaked)
+	if summary.count() == 0 {
+		t.Fatal("fixture did not compact")
+	}
+	if leaked != 0 {
+		t.Fatalf("transient OnModelStart replacement persisted in %d history boundaries", leaked)
+	}
+}
