+package agent_v2_test
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"crew-go/agent_v2"
+	"crew-go/compose_v2"
+	"crew-go/hook"
+	"crew-go/schema"
+)
+
+type zzAuditStartAsk struct{ hook.NoOpHooks }
+
+func (zzAuditStartAsk) OnAgentStart(ctx context.Context, _ *hook.AgentInfo, _ *hook.AgentInput) (context.Context, error) {
+	_, err := compose_v2.Ask(ctx, &compose_v2.AskQuery{Question: "批准 B 开始"})
+	return ctx, err
+}
+
+func TestZZAuditParallelResumeSiblingIsolation(t *testing.T) {
+	t.Run("control_fresh_session", func(t *testing.T) { zzAuditParallelResume(t, false) })
+	t.Run("preserved_session", func(t *testing.T) { zzAuditParallelResume(t, true) })
+}
+
+func zzAuditParallelResume(t *testing.T, preserveSession bool) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	ctx = compose_v2.WithCheckpointerCtx(ctx, compose_v2.NewInMemoryCheckpointer())
+	a, b, mb := sameNameWorkers(zzAuditStartAsk{})
+	par := agent_v2.NewParallelAgent(agent_v2.WithParallelName("zz-par")).AddBranch("a", a).AddBranch("b", b)
+	sess := agent_v2.NewRunSession()
+	_, err := par.Run(ctx, sess, schema.UserMessage(laneQ))
+	ie, ok := compose_v2.IsInterrupt(err)
+	if !ok || len(ie.AllQueries()) != 1 {
+		t.Fatalf("want one question, got %v", err)
+	}
+	opts := []agent_v2.ResumeOption{agent_v2.WithResumeUserInputs(map[string]*schema.Message{ie.AllQueries()[0].InterruptID: schema.UserMessage("yes")})}
+	if preserveSession {
+		opts = append(opts, agent_v2.WithResumeSession(sess))
+	}
+	_, err = par.Resume(ctx, sess.RunID, opts...)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, msg := range mb.call(0) {
+		t.Logf("B received %s: %q", msg.Role, msg.Content)
+		if msg.Content == "A-ans" {
+			t.Error("B resumed preamble received successful sibling A output")
+		}
+	}
+}
+
+func TestZZAuditDecisionSessionIsolation(t *testing.T) {
+	t.Run("control_distinct_name", func(t *testing.T) { zzAuditDecisionSession(t, "evaluator") })
+	t.Run("same_name", func(t *testing.T) { zzAuditDecisionSession(t, "worker") })
+}
+
+func zzAuditDecisionSession(t *testing.T, evaluatorName string) {
+	ma := &scriptModel{steps: []func([]*schema.Message) (*schema.Message, error){reply(schema.AssistantMessage("draft")), reply(schema.AssistantMessage("final"))}}
+	me := &scriptModel{steps: []func([]*schema.Message) (*schema.Message, error){reply(schema.AssistantMessage("PRIVATE-CRITIQUE")), reply(schema.AssistantMessage("yes"))}}
+	actor := agent_v2.NewBasicAgent(agent_v2.WithName("worker"), agent_v2.WithModel(ma))
+	eval := agent_v2.NewBasicAgent(agent_v2.WithName(evaluatorName), agent_v2.WithModel(me))
+	r := agent_v2.NewReflectAgent(agent_v2.WithReflectName("zz-reflect"), agent_v2.WithReflectMaxRounds(2), agent_v2.WithEvaluator(eval)).WithActor(actor)
+	if _, err := r.Run(context.Background(), agent_v2.NewRunSession(), schema.UserMessage("用户请求")); err != nil {
+		t.Fatal(err)
+	}
+	if ma.count() != 2 || me.count() != 2 {
+		t.Fatalf("wrong calls actor=%d eval=%d", ma.count(), me.count())
+	}
+	for _, msg := range ma.call(1) {
+		t.Logf("actor round 2 received %s: %q", msg.Role, msg.Content)
+		if msg.Role == "assistant" && msg.Content == "PRIVATE-CRITIQUE" {
+			t.Error("internal evaluator reply became actor's own previous assistant message")
+		}
+	}
+}
+
+func TestZZAuditPlanTmpHistorySlotCollision(t *testing.T) {
+	t.Run("control_distinct_slot", func(t *testing.T) { zzAuditPlanTmpSlot(t, "normal_slot") })
+	t.Run("colliding_slot", func(t *testing.T) { zzAuditPlanTmpSlot(t, "tmp_step_0") })
+}
+
+func zzAuditPlanTmpSlot(t *testing.T, registeredName string) {
+	ctx, _ := historyCtx("zz-plan-history")
+	tmpModel := &scriptModel{steps: []func([]*schema.Message) (*schema.Message, error){reply(schema.AssistantMessage("TMP-PRIVATE-OUTPUT"))}}
+	workerModel := &scriptModel{steps: []func([]*schema.Message) (*schema.Message, error){reply(schema.AssistantMessage("worker done"))}}
+	worker := agent_v2.NewBasicAgent(agent_v2.WithName("normal-worker"), agent_v2.WithModel(workerModel))
+	planner := func(_ context.Context, _ *agent_v2.RunSession, _ string, done []agent_v2.ExecutedStep) ([]agent_v2.PlanStep, string, error) {
+		switch len(done) {
+		case 0:
+			return []agent_v2.PlanStep{{Description: "临时任务", TmpSubAgent: &agent_v2.TmpSubAgentConfig{}}}, "", nil
+		case 1:
+			return []agent_v2.PlanStep{{Description: "独立任务", SubAgentName: registeredName}}, "", nil
+		default:
+			return nil, "done", nil
+		}
+	}
+	p := agent_v2.NewPlanAgent(planner, agent_v2.PlanName("zz-plan"), agent_v2.WithPlanModel(tmpModel),
+		agent_v2.WithSubAgents(map[string]agent_v2.Agent{registeredName: worker}),
+		agent_v2.WithExecInputBuilder(func(_ context.Context, _ string, _ []agent_v2.ExecutedStep, current agent_v2.PlanStep, _ []int) (*schema.Message, error) {
+			return schema.UserMessage(current.Description), nil
+		}))
+	if _, err := p.Run(ctx, agent_v2.NewRunSession(), schema.UserMessage("原始请求")); err != nil {
+		t.Fatal(err)
+	}
+	if tmpModel.count() != 1 || workerModel.count() != 1 {
+		t.Fatalf("wrong calls tmp=%d worker=%d", tmpModel.count(), workerModel.count())
+	}
+	for _, msg := range workerModel.call(0) {
+		t.Logf("worker received %s: %q", msg.Role, msg.Content)
+		if strings.Contains(msg.Content, "TMP-PRIVATE-OUTPUT") {
+			t.Error("explicit worker received temporary worker's private history")
+		}
+	}
+}
