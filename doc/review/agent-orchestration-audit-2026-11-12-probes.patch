+	_, err := ag.Run(ctx, sess, schema.UserMessage("new question"))
+	ie, ok := compose_v2.IsInterrupt(err)
+	if !ok {
+		t.Fatal(err)
+	}
+	_, err = ag.Resume(ctx, sess.RunID, agent_v2.WithResumeSession(sess), agent_v2.WithResumeUserInputs(map[string]*schema.Message{ie.AllQueries()[0].InterruptID: schema.UserMessage("yes")}))
+	t.Logf("primary calls=%d answered=%d err=%v", m.calls, m.answered, err)
+	if err != nil || m.calls != 2 || m.answered != 1 {
+		t.Fatalf("positive control failed: %v", err)
+	}
+}
