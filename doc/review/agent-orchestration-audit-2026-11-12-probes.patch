new file mode 100644
--- /dev/null
+++ b/agui/zz_audit_abort_cleanup_test.go
@@ -0,0 +1,59 @@
+package agui_test
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"crew-go/agent_v2"
+	"crew-go/agui"
+	"crew-go/compose_v2"
+	"crew-go/hook"
+)
+
+type zzFailAbortCP struct {
+	compose_v2.Checkpointer
+	fail bool
+	sid  string
+}
+
+func (c *zzFailAbortCP) SaveNS(ctx context.Context, sid, ns string, cp *compose_v2.Checkpoint) error {
+	c.sid = sid
+	return c.Checkpointer.SaveNS(ctx, sid, ns, cp)
+}
+
+func (c *zzFailAbortCP) DeleteSubtree(ctx context.Context, sid, ns string) (int32, error) {
+	if c.fail {
+		return 0, errors.New("temporary delete outage")
+	}
+	return c.Checkpointer.DeleteSubtree(ctx, sid, ns)
+}
+
+func TestZZAuditAbortFailureRetainsRetryHandle(t *testing.T) {
+	cp := &zzFailAbortCP{Checkpointer: compose_v2.NewInMemoryCheckpointer()}
+	h := ownedHandler(func(hooks hook.Hooks) agent_v2.Agent {
+		return agent_v2.NewBasicAgent(agent_v2.WithName("audit-abort"), agent_v2.WithModel(&askThenAnswerModel{}), agent_v2.WithAskUser(), agent_v2.WithHooks(hooks))
+	}, agui.WithCheckpointer(cp))
+	iid := findInterruptID(parseSSE(postAGUI(h, `{"threadId":"audit-abort","runId":"start","messages":[{"role":"user","content":"hi"}]}`).Body.String()))
+	if iid == "" {
+		t.Fatal("missing interrupt")
+	}
+	cp.fail = true
+	body := `{"threadId":"audit-abort","runId":"cancel","resume":[{"interruptId":"` + iid + `","status":"cancelled"}]}`
+	first := postAGUI(h, body)
+	if !strings.Contains(first.Body.String(), `"type":"cancelled"`) {
+		t.Fatalf("expected current best-effort cancel behavior: %s", first.Body.String())
+	}
+	cp.fail = false
+	saved, err := cp.LoadNS(context.Background(), cp.sid, "")
+	if err != nil || saved == nil {
+		t.Fatalf("checkpoint missing before retry: %v", err)
+	}
+	second := postAGUI(h, body)
+	saved, err = cp.LoadNS(context.Background(), cp.sid, "")
+	t.Logf("retry_http=%d retry=%s checkpoint_retained=%v", second.Code, second.Body.String(), saved != nil)
+	if err != nil || saved != nil {
+		t.Fatal("abort failure discarded session handle, so healthy backend cannot clean checkpoint on retry")
+	}
+}
