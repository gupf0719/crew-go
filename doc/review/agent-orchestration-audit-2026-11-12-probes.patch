+package server_test
+
+import (
+	"context"
+	"crew-go/a2a"
+	"crew-go/agent_v2"
+	"crew-go/hook"
+	"crew-go/schema"
+	"testing"
+)
+
+type zzInPlaceRedactOnEnd struct{ hook.NoOpHooks }
+
+func (zzInPlaceRedactOnEnd) OnModelEnd(ctx context.Context, _ *hook.AgentInfo, out *schema.ModelOutput) (context.Context, error) {
+	out.Message.Content = "REDACTED"
+	return ctx, nil
+}
+func TestZZAuditRemoteAgentInPlaceReplacement(t *testing.T) {
+	base := serveAgent(t, agent_v2.NewBasicAgent(agent_v2.WithName("redact-inplace"), agent_v2.WithModel(&streamModel{}), agent_v2.WithHooks(zzInPlaceRedactOnEnd{})))
+	ra, err := a2a.NewRemoteAgent(context.Background(), base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	events, err := ra.Run(context.Background(), agent_v2.NewRunSession(), schema.UserMessage("hi"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := agent_v2.FinalMessage(events).Content
+	t.Logf("remote final=%q", got)
+	if got != "REDACTED" {
+		t.Fatalf("remote final kept pre-hook original: %q", got)
+	}
+}
