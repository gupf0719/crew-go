+package compose_v2_test
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"crew-go/compose_v2"
+)
+
+// 同一超步的单写入者规则不能因为兄弟分支中途失败而放行。
+func TestZZAuditSingleWriterAcrossResume(t *testing.T) {
+	for _, pause := range []bool{false, true} {
+		t.Run(fmt.Sprintf("pause=%v", pause), func(t *testing.T) {
+			value := compose_v2.LastValue[string]("shared")
+			var aCalls, bCalls atomic.Int32
+			b := compose_v2.NewBuilder()
+			compose_v2.WithChannel(b, value)
+			b.AddNode("A", func(context.Context, compose_v2.Channels) ([]compose_v2.ChannelWrite, error) {
+				if aCalls.Add(1) == 1 && pause {
+					return nil, errors.New("transient A failure")
+				}
+				return []compose_v2.ChannelWrite{compose_v2.Write(value, "A")}, nil
+			})
+			b.AddNode("B", func(context.Context, compose_v2.Channels) ([]compose_v2.ChannelWrite, error) {
+				bCalls.Add(1)
+				return []compose_v2.ChannelWrite{compose_v2.Write(value, "B")}, nil
+			})
+			b.AddEdge(compose_v2.StartNode, "A").AddEdge(compose_v2.StartNode, "B")
+			b.AddEdge("A", compose_v2.EndNode).AddEdge("B", compose_v2.EndNode)
+			g, err := b.Compile()
+			if err != nil {
+				t.Fatal(err)
+			}
+			cp := compose_v2.NewInMemoryCheckpointer()
+			ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+			defer cancel()
+			const sid = "zz-single-writer-resume"
+			cm := compose_v2.NewChannelManager()
+			err = compose_v2.Run(ctx, g, cm, compose_v2.WithCheckpointer(cp), compose_v2.WithSessionID(sid))
+			if pause {
+				if err == nil {
+					t.Fatal("first run should fail")
+				}
+				saved, loadErr := cp.LoadNS(ctx, sid, "")
+				if loadErr != nil || saved == nil || len(saved.CurrentFrontier) != 1 || len(saved.CompletedFrontier) != 1 {
+					t.Fatalf("bad partial checkpoint: %+v err=%v", saved, loadErr)
+				}
+				t.Logf("after pause: value=%s frontier=%v completed=%v", compose_v2.MustGet(cm.Channels(), value), saved.CurrentFrontier, saved.CompletedFrontier)
+				cm = compose_v2.NewChannelManager()
+				err = compose_v2.Run(ctx, g, cm, compose_v2.WithCheckpointer(cp), compose_v2.WithSessionID(sid))
+			}
+			final, _ := compose_v2.Get(cm.Channels(), value)
+			t.Logf("final: err=%v value=%s A=%d B=%d", err, final, aCalls.Load(), bCalls.Load())
+			if !errors.Is(err, compose_v2.ErrRunAborted) {
+				t.Fatalf("same superstep has two LastValue writers but err=%v, final=%s", err, final)
+			}
+		})
+	}
+}
