+type zzInPlaceRedact struct{ hook.NoOpHooks }
+
+func (zzInPlaceRedact) OnModelEnd(ctx context.Context, _ *hook.AgentInfo, out *schema.ModelOutput) (context.Context, error) {
+	out.Message.Content = "[redacted]"
+	return ctx, nil
+}
+func TestZZAuditInPlaceModelEndRewrite(t *testing.T) {
+	capture := &captureEventsHook{}
+	ag := agent_v2.NewBasicAgent(agent_v2.WithName("audit"), agent_v2.WithModel(&chunkStreamModel{contents: []string{"secret", " value"}}), agent_v2.WithHooks(zzInPlaceRedact{}))
+	events, err := ag.Run(context.Background(), &agent_v2.RunSession{RunID: "zz-audit-redact"}, schema.UserMessage("hello"), agent_v2.WithOrchHooks(capture))
+	if err != nil {
+		t.Fatal(err)
+	}
+	final := agent_v2.FinalMessage(events)
+	if final == nil || final.Content != "[redacted]" {
+		t.Fatalf("final=%+v", final)
+	}
+	var raw strings.Builder
+	reset := false
+	for _, ev := range capture.events {
+		if ev.Type == "chunk" {
+			raw.WriteString(ev.Content)
+		}
+		if ev.Type == "reset_stream" && ev.Metadata["replacement"] == "[redacted]" {
+			reset = true
+		}
+	}
+	t.Logf("final=%q chunks=%q replacement_event=%v", final.Content, raw.String(), reset)
+	if raw.String() == "secret value" && !reset {
+		t.Fatal("in-place OnModelEnd rewrite leaves original chunks visible without replacement event")
+	}
+}
