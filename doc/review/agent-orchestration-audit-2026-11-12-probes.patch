+package compose_v2_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"crew-go/compose_v2"
+	"crew-go/schema"
+)
+
+func TestZZAuditInterfaceChannelResume(t *testing.T) {
+	value := compose_v2.LastValue[any]("interface_value")
+	b := compose_v2.NewBuilder()
+	compose_v2.WithChannel(b, value)
+	writes, reads := 0, 0
+	b.AddNode("write", func(context.Context, compose_v2.Channels) ([]compose_v2.ChannelWrite, error) {
+		writes++
+		return []compose_v2.ChannelWrite{compose_v2.Write[any](value, "hello")}, nil
+	})
+	b.AddNode("read", func(ctx context.Context, chs compose_v2.Channels) ([]compose_v2.ChannelWrite, error) {
+		reads++
+		got := compose_v2.MustGet(chs, value)
+		if got != "hello" {
+			t.Errorf("read %v, want hello", got)
+		}
+		_, err := compose_v2.Ask(ctx, &compose_v2.AskQuery{Question: "continue?"})
+		return nil, err
+	})
+	b.AddEdge(compose_v2.StartNode, "write").AddEdge("write", "read").AddEdge("read", compose_v2.EndNode)
+	g, err := b.Compile()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cp := compose_v2.NewInMemoryCheckpointer()
+	ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+	defer cancel()
+	const sid = "zz-interface-channel"
+	err = compose_v2.Run(ctx, g, compose_v2.NewChannelManager(), compose_v2.WithCheckpointer(cp), compose_v2.WithSessionID(sid))
+	ie, ok := compose_v2.IsInterrupt(err)
+	if !ok {
+		t.Fatalf("expected first interrupt: %v", err)
+	}
+	t.Logf("before resume: writes=%d reads=%d", writes, reads)
+	err = compose_v2.Run(ctx, g, compose_v2.NewChannelManager(), compose_v2.WithCheckpointer(cp), compose_v2.WithSessionID(sid), compose_v2.WithResumeAnswers(map[string]*schema.Message{ie.AllQueries()[0].InterruptID: schema.UserMessage("yes")}))
+	if err != nil {
+		t.Fatalf("valid interface channel cannot resume: %v (writes=%d reads=%d)", err, writes, reads)
+	}
+	if writes != 1 || reads != 2 {
+		t.Fatalf("unexpected execution counts writes=%d reads=%d", writes, reads)
+	}
+}
